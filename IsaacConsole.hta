    ];

    var currentCat = "featured";
    var favorites = {};
    var historyList = [];
    var sendBusy = false;
    var pendingStatusPath = "";
    var pendingCommand = "";
    var pendingLabel = "";
    var pendingStarted = 0;
    var pendingDeadline = 0;
    var pendingRepeatCount = 1;
    var pendingRequestedRepeat = 1;
    var pendingCompleted = 0;
    var pendingRepeatLimited = false;
    var probeBusy = false;
    var probeStatusPath = "";
    var probeStarted = 0;
    var gameKnownRunning = false;

    function safeParse(text, fallback) { try { return JSON.parse(text); } catch(e) { return fallback; } }
    function loadState() {
      try {
        favorites = safeParse(localStorage.getItem("isaac_favorites") || "{}", {});
        historyList = safeParse(localStorage.getItem("isaac_history") || "[]", []);
      } catch(e) { favorites = {}; historyList = []; }
      if (historyList.length) document.getElementById("recent").innerText = "最近：" + historyList[0];
    }
    function saveState() {
      try {
        localStorage.setItem("isaac_favorites", JSON.stringify(favorites));
        localStorage.setItem("isaac_history", JSON.stringify(historyList.slice(0,20)));
      } catch(e) {}
    }
    function getCategory(id) { for (var i=0;i<categories.length;i++) if(categories[i].id===id) return categories[i]; return categories[0]; }
    function countCategory(id) {
      if (id === "featured") {
        var count = 0; for (var key in favorites) if(favorites[key]) count++;
        return count ? count : 12;
      }
      var count2=0, i; for(i=0;i<items.length;i++) if(items[i].cat===id) count2++; for(i=0;i<commands.length;i++) if(commands[i].cat===id) count2++; return count2;
    }
    function renderNav() {
      var html="", lastGroup="";
      for(var i=0;i<categories.length;i++) {
        var c=categories[i];
        if(c.group!==lastGroup) { html += '<div class="nav-label">'+c.group+'</div>'; lastGroup=c.group; }
        html += '<button class="nav-btn '+(c.id===currentCat?'active':'')+'" onclick="selectCategory(\''+c.id+'\')"><span class="nav-icon">'+c.icon+'</span>'+c.name+'<span class="nav-count">'+countCategory(c.id)+'</span></button>';
      }
      document.getElementById("nav").innerHTML=html;
    }
    function selectCategory(id) {
      currentCat=id; document.getElementById("search").value=""; renderNav(); renderCards();
      document.getElementById("content").scrollTop=0;
    }
    function escapeHtml(s) { return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/\"/g,"&quot;"); }
    function getVisibleData() {
      var result=[], i, hasFav=false;
      if(currentCat==="featured") {
        for(i=0;i<items.length;i++) if(favorites[items[i].id]) { result.push(items[i]); hasFav=true; }
        if(!hasFav) {
          var picks=[182,331,118,313,581,64,580,105,723,360,698,721];
          for(i=0;i<picks.length;i++) for(var j=0;j<items.length;j++) if(items[j].id===picks[i]) result.push(items[j]);
        }
      } else {
        for(i=0;i<items.length;i++) if(items[i].cat===currentCat) result.push(items[i]);
        for(i=0;i<commands.length;i++) if(commands[i].cat===currentCat) result.push(commands[i]);
      }
      var q=document.getElementById("search").value.toLowerCase().replace(/^\s+|\s+$/g,"");
      if(q) {
        result=[];
        var all=items.concat(commands);
        for(i=0;i<all.length;i++) {
          var d=all[i], hay=(d.name+" "+d.en+" "+d.desc+" "+(d.id||"")+" "+(d.cmd||"")).toLowerCase();
          if(hay.indexOf(q)>=0) result.push(d);
        }
      }
      return result;
    }
    function renderCards() {
      var c=getCategory(currentCat), q=document.getElementById("search").value;
      document.getElementById("pageTitle").innerText=q ? "搜索结果" : c.name;
      document.getElementById("pageDesc").innerText=q ? "正在全库搜索："+q : c.desc;
      document.getElementById("eyebrow").innerText=q ? "GLOBAL SEARCH" : c.eyebrow;
      var data=getVisibleData(), html="";
      if(!data.length) { html='<div class="empty"><div class="empty-big">⌁</div>没有找到匹配内容</div>'; }
      else {
        html='<div class="section-title"><strong>'+(q?'匹配项目':(currentCat==='featured'?'优先推荐':'全部项目'))+'</strong>'+data.length+' 项</div><div class="grid">';
        for(var i=0;i<data.length;i++) html += renderCard(data[i]);
        html+='</div>';
      }
      document.getElementById("cards").innerHTML=html;
    }
    function renderCard(d) {
      var isItem=!!d.id, cmd=d.cmd || ("giveitem c"+d.id), tierClass=d.tier==="A"?" a":"", sigClass=d.tier==="S"?"":" gold";
      if(d.cat==="explore") sigClass=" blue"; if(d.cat==="defense"||d.cat==="economy") sigClass=" green";
      var favBtn=isItem?'<button class="fav '+(favorites[d.id]?'on':'')+'" title="收藏" onclick="toggleFav(event,'+d.id+')">★</button>':'';
      var remove=isItem?'<button class="remove-btn" onclick="sendCommand(\'remove c'+d.id+'\',\'移除 '+escapeHtml(d.name)+'\')">移除</button>':'';
      var action=isItem?'给予':'执行';
      return '<div class="card-wrap"><div class="card '+(d.hot?'hot ':'')+(!isItem?'command-card':'')+'"><div class="card-glow"></div><div class="card-head"><div class="sigil'+sigClass+'">'+escapeHtml(d.icon)+'</div><div class="item-main"><div class="item-name">'+escapeHtml(d.name)+'</div><div class="item-en">'+escapeHtml(d.en)+'</div></div><span class="tier'+tierClass+'">'+d.tier+'</span>'+favBtn+'</div><div class="item-desc">'+escapeHtml(d.desc)+'</div><div class="card-foot"><span class="code">'+escapeHtml(cmd)+'</span>'+remove+'<button class="give-btn" onclick="sendCommand(\''+cmd+'\',\''+action+' '+escapeHtml(d.name)+'\')">'+action+'</button></div></div></div>';
    }
    function toggleFav(ev,id) {
      if(ev) ev.cancelBubble=true; favorites[id]=!favorites[id]; saveState(); renderNav(); renderCards();
      toast(favorites[id]?"已加入常用精选":"已取消收藏", "ok");
    }
    function updateGameStatus() {
      if(probeBusy || sendBusy) return;
      try {
        var fso=new ActiveXObject("Scripting.FileSystemObject"), shell=new ActiveXObject("WScript.Shell"), temp=fso.GetSpecialFolder(2).Path;
        var unique=(new Date().getTime())+"-"+Math.floor(Math.random()*100000);
        probeStatusPath=fso.BuildPath(temp,"isaac-cn-probe-"+unique+".dat"); probeStarted=new Date().getTime(); probeBusy=true;
        var ps='powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "'+appDir()+'\\send-command.ps1" -ProbeOnly -StatusFile "'+probeStatusPath+'"';
        shell.Run(ps,0,false); setTimeout(pollGameProbe,160);
      } catch(ex) { setGameStatus(false,"检测组件不可用"); probeBusy=false; }
    }
    function pollGameProbe() {
      if(!probeBusy) return;
      try {
        var fso=new ActiveXObject("Scripting.FileSystemObject");
        if(fso.FileExists(probeStatusPath)) {
          var f=fso.OpenTextFile(probeStatusPath,1,false,0), result=f.ReadAll(); f.Close();
          try{fso.DeleteFile(probeStatusPath,true);}catch(ignore){}
          probeBusy=false;
          if(result.indexOf("RUNNING")===0) setGameStatus(true,"游戏运行中"); else setGameStatus(false,"未检测到游戏");
          return;
        }
      } catch(e) {}
      if(new Date().getTime()-probeStarted>4500) { probeBusy=false; setGameStatus(false,"检测超时，可直接尝试发送"); return; }
      setTimeout(pollGameProbe,160);
    }
    function setGameStatus(on,label) {
      gameKnownRunning=on;
      var dot=document.getElementById("statusDot"), text=document.getElementById("statusText");
      dot.className="status-dot"+(on?" online":""); text.innerText=label;
    }
    function appDir() {
      var p=decodeURIComponent(location.pathname).replace(/^\//,"").replace(/\//g,"\\");
      return p.substring(0,p.lastIndexOf("\\"));
    }
    function writeCommandFile(cmd) {
      var fso=new ActiveXObject("Scripting.FileSystemObject"), temp=fso.GetSpecialFolder(2).Path, unique=(new Date().getTime())+"-"+Math.floor(Math.random()*100000);
      var commandPath=fso.BuildPath(temp,"isaac-cn-command-"+unique+".dat"), statusPath=fso.BuildPath(temp,"isaac-cn-status-"+unique+".dat");
      var f=fso.CreateTextFile(commandPath,true,true); f.Write(cmd); f.Close();
      return {command:commandPath,status:statusPath};
    }
    function isRepeatSafe(cmd) { return /^\s*(giveitem|spawn)\s+/i.test(String(cmd)); }
    function updateRepeatWarning(count) {
      var el=document.getElementById("repeatWarning");
      el.style.display=count>20?"inline-block":"none";
    }
    function normalizeRepeat(finalize) {
      var el=document.getElementById("repeatCount"), raw=String(el.value).replace(/[^0-9]/g,"");
      if(!raw) {
        if(finalize) el.value="1";
        updateRepeatWarning(1); return 1;
      }
      var count=parseInt(raw,10); if(isNaN(count)) count=1;
      if(count<1) count=1; if(count>99) count=99;
      el.value=String(count); updateRepeatWarning(count); return count;
    }
    function getRepeatCount() { return normalizeRepeat(true); }
    function adjustRepeat(delta) {
      var count=getRepeatCount()+delta; if(count<1) count=1; if(count>99) count=99;
      document.getElementById("repeatCount").value=String(count); updateRepeatWarning(count);
    }
    function resetRepeat() { document.getElementById("repeatCount").value="1"; updateRepeatWarning(1); }
    function sendCommand(cmd,label) {
      cmd=String(cmd).replace(/^\s+|\s+$/g,""); if(!cmd) return;
      document.getElementById("manualCommand").value=cmd;
      document.getElementById("recent").innerText="当前："+cmd;
      if(sendBusy) { toast("上一条命令仍在发送，请稍候。", "warn"); return; }
      if(cmd.length>500 || /[\r\n]/.test(cmd)) { toast("为避免误执行，每次只能发送一条、最多 500 字符的命令。", "warn"); return; }
      try {
        var shell=new ActiveXObject("WScript.Shell"), base=appDir(), files=writeCommandFile(cmd);
        var mode=document.getElementById("sendMode").value, requested=getRepeatCount(), repeat=requested, limited=false;
        if(requested>1 && !isRepeatSafe(cmd)) { repeat=1; limited=true; toast("为避免危险操作重复执行，此命令只执行 1 次。", "warn"); }
        var ps='powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "'+base+'\\send-command.ps1" -CommandFile "'+files.command+'" -StatusFile "'+files.status+'" -RepeatCount '+repeat+(mode==="open"?' -ConsoleAlreadyOpen':'');
        sendBusy=true; pendingStatusPath=files.status; pendingCommand=cmd; pendingLabel=label||"命令"; pendingStarted=new Date().getTime();
        pendingDeadline=pendingStarted+Math.min(70000,Math.max(8500,repeat*600+10000)); pendingRepeatCount=repeat; pendingRequestedRepeat=requested; pendingCompleted=0; pendingRepeatLimited=limited;
        setSendingState(true,0,repeat);
        shell.Run(ps,0,false); setTimeout(pollSendStatus,140);
      } catch(ex) { sendBusy=false; setSendingState(false,0,1); copyText(cmd); toast("自动发送失败，命令已复制。", "warn"); }
    }
    function setSendingState(busy,done,total) {
      var btn=document.getElementById("sendBtn"); btn.className="send-btn"+(busy?" disabled":"");
      btn.innerText=busy?(total>1?("正在执行 "+done+"/"+total):"正在发送…"):"发送到游戏";
    }
    function pollSendStatus() {
      if(!sendBusy) return;
      try {
        var fso=new ActiveXObject("Scripting.FileSystemObject");
        if(fso.FileExists(pendingStatusPath)) {
          var f=fso.OpenTextFile(pendingStatusPath,1,false,0), result=f.ReadAll(); f.Close();
          if(String(result).indexOf("PROGRESS|")===0) {
            var progress=String(result).split("|"), done=parseInt(progress[1],10)||0, total=parseInt(progress[2],10)||pendingRepeatCount;
            if(done>pendingCompleted) { pendingCompleted=done; setSendingState(true,done,total); }
            setTimeout(pollSendStatus,140); return;
          }
          try { fso.DeleteFile(pendingStatusPath,true); } catch(ignore) {}
          finishSend(result); return;
        }
      } catch(e) {}
      if(new Date().getTime()>pendingDeadline) {
        if(pendingCompleted>0) finishSend("PARTIAL|"+pendingCompleted+"|"+pendingRepeatCount+"|TIMEOUT");
        else finishSend("ERR|TIMEOUT");
        return;
      }
      setTimeout(pollSendStatus,140);
    }
    function finishSend(result) {
      var text=String(result), parts=text.split("|"), historyEntry="";
      sendBusy=false; setSendingState(false,0,1);
      if(text.indexOf("SENT|")===0) {
        var actual=parseInt(parts[2],10)||1;
        historyEntry=pendingCommand+(actual>1?(" ×"+actual):"");
        historyList.unshift(historyEntry); historyList=historyList.slice(0,20); saveState(); document.getElementById("recent").innerText="最近："+historyEntry;
        resetRepeat();
        if(parts[1]==="CLOSE_FAILED") toast(pendingLabel+" · 已执行 "+actual+" 次，但控制台关闭按键被系统拦截", "warn");
        else if(pendingRepeatLimited) toast(pendingLabel+" · 按安全规则仅执行 1 次，并已关闭控制台", "warn");
        else toast(pendingLabel+" · 已执行 "+actual+" 次并关闭游戏控制台", "ok");
      } else if(text.indexOf("PARTIAL|")===0) {
        var completed=parseInt(parts[1],10)||0, total=parseInt(parts[2],10)||pendingRepeatCount, reason=parts[3]||"UNKNOWN";
        if(completed>0) {
          historyEntry=pendingCommand+(completed>1?(" ×"+completed):"");
          historyList.unshift(historyEntry); historyList=historyList.slice(0,20); saveState(); document.getElementById("recent").innerText="最近："+historyEntry;
          resetRepeat();
        }
        var reasons={FOCUS_LOST:"游戏中途失去焦点",INPUT_BLOCKED:"按键注入被系统拦截",TIMEOUT:"等待发送器超时"};
        toast(pendingLabel+" · 仅完成 "+completed+"/"+total+"（"+(reasons[reason]||reason)+"），请勿直接重复领取", "warn");
      } else {
        copyText(pendingCommand);
        var code=parts[1]||"UNKNOWN", tips={NO_GAME:"游戏已关闭，命令已复制。",NO_WINDOW:"没有找到游戏窗口，请进入一局后重试。",FOCUS_FAILED:"无法把游戏切到前台；请让游戏和工具使用相同权限。",FOCUS_LOST:"输入前游戏失去焦点，命令已复制。",INPUT_BLOCKED:"Windows 阻止了按键输入，命令已复制。",TIMEOUT:"发送器响应超时；未确认执行成功，命令已复制。",REPEAT_RANGE:"执行次数必须为 1–99。",REPEAT_NOT_ALLOWED:"该命令不允许批量执行。"};
        toast(tips[code]||"自动发送失败（"+code+"），命令已复制。", "warn");
      }
      pendingStatusPath=""; pendingCommand=""; pendingLabel=""; pendingDeadline=0; pendingRepeatCount=1; pendingRequestedRepeat=1; pendingCompleted=0; pendingRepeatLimited=false;
    }
    function copyText(text) {
      try { window.clipboardData.setData("Text",text); return true; } catch(e) { return false; }
    }
    function copyManual() { var c=document.getElementById("manualCommand").value; copyText(c); toast("命令已复制", "ok"); }
    function sendManual() { sendCommand(document.getElementById("manualCommand").value,"手动命令"); }
    function showHistory() {
      if(!historyList.length) { toast("还没有发送过命令", "warn"); return; }
      document.getElementById("manualCommand").value=String(historyList[0]).replace(/ ×\d+$/,"");
      toast("最近命令："+historyList.slice(0,4).join("　|　"), "");
    }
    function confirmClearItems() {
      if(confirm("确定移除当前角色的全部道具吗？\n\n这会执行 remove *，建议先确认当前局是否需要保留。")) sendCommand("remove *","清空全部道具");
    }
    function showTutorial() { document.getElementById("tutorialModal").style.display="flex"; }
    function hideTutorial() { document.getElementById("tutorialModal").style.display="none"; try{localStorage.setItem("isaac_tutorial_seen","1");}catch(e){} }
    var toastTimer=null;
    function toast(text,type) {
      var el=document.getElementById("toast"); el.className="toast "+(type||""); el.innerText=text; el.style.display="block";
      if(toastTimer) clearTimeout(toastTimer); toastTimer=setTimeout(function(){el.style.display="none";},2800);
    }
    function init() {
      try { window.resizeTo(1280,840); window.moveTo(Math.max(0,(screen.availWidth-1280)/2),Math.max(0,(screen.availHeight-840)/2)); } catch(e) {}
      loadState(); renderNav(); renderCards(); updateGameStatus(); setInterval(updateGameStatus,3500);
      document.getElementById("search").onkeyup=function(){renderCards();};
      document.getElementById("manualCommand").onkeydown=function(e){e=e||window.event;if(e.keyCode===13)sendManual();};
      document.onkeydown=function(e){e=e||window.event;if(e.ctrlKey&&e.keyCode===75){document.getElementById("search").focus();e.returnValue=false;}};
      try { if(localStorage.getItem("isaac_tutorial_seen")!=="1") setTimeout(showTutorial,350); } catch(e) { setTimeout(showTutorial,350); }
    }
    window.onload=init;
  </script>
</body>
</html>
