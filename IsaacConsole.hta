<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>以撒 · 中文控制台 1.3.0</title>
  <HTA:APPLICATION
    ID="IsaacConsole"
    APPLICATIONNAME="Isaac 中文控制台"
    BORDER="thin"
    CAPTION="yes"
    MAXIMIZEBUTTON="yes"
    MINIMIZEBUTTON="yes"
    SCROLL="no"
    SINGLEINSTANCE="yes"
    WINDOWSTATE="normal"
  />
  <style>
    * { box-sizing: border-box; }
    html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; }
    body {
      font-family: "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
      color: #f4ead8;
      background: #120f14;
      letter-spacing: .1px;
    }
    button, input { font-family: inherit; }
    button { cursor: pointer; }
    .app { height: 100%; min-width: 900px; display: flex; background: radial-gradient(circle at 78% 5%, #37202c 0, #19141a 36%, #100e12 78%); }
    .sidebar {
      width: 232px; min-width: 232px; padding: 22px 14px 16px;
      background: linear-gradient(180deg, #211820 0%, #151116 100%);
      border-right: 1px solid #46313a; position: relative;
    }
    .brand { padding: 0 10px 22px; border-bottom: 1px solid #3c2b33; }
    .brand-top { color: #d74b58; font-size: 11px; font-weight: 800; letter-spacing: 3px; }
    .brand-title { margin-top: 7px; font-size: 23px; font-weight: 900; color: #fff6e8; }
    .brand-sub { margin-top: 4px; color: #8e7c80; font-size: 11px; }
    .nav { margin-top: 16px; height: calc(100% - 190px); overflow-y: auto; padding-right: 3px; }
    .nav::-webkit-scrollbar, .content::-webkit-scrollbar { width: 7px; }
    .nav::-webkit-scrollbar-thumb, .content::-webkit-scrollbar-thumb { background: #4b3540; border-radius: 8px; }
    .nav-label { color: #77666c; font-size: 10px; font-weight: 700; letter-spacing: 2px; padding: 7px 11px; }
    .nav-btn {
      width: 100%; border: 0; margin: 2px 0; padding: 10px 11px; border-radius: 9px;
      color: #ae9ca1; background: transparent; text-align: left; font-size: 13px;
      transition: .16s;
    }
    .nav-btn:hover { color: #f5e9dc; background: #2a2027; }
    .nav-btn.active { color: #fff; background: linear-gradient(90deg, #81333e, #4b2630); box-shadow: inset 3px 0 #ef6976; }
    .nav-icon { display: inline-block; width: 25px; font-size: 14px; text-align: center; margin-right: 5px; }
    .nav-count { float: right; margin-top: 1px; color: #8b747a; font-size: 10px; }
    .status-box { position: absolute; left: 14px; right: 14px; bottom: 15px; padding: 11px 12px; border: 1px solid #3e3036; border-radius: 10px; background: #1b161b; }
    .status-line { font-size: 11px; color: #b8a6aa; }
    .status-dot { width: 8px; height: 8px; display: inline-block; margin-right: 7px; border-radius: 50%; background: #a44; box-shadow: 0 0 8px #a44; }
    .status-dot.online { background: #5cc48b; box-shadow: 0 0 8px #5cc48b; }
    .status-tip { margin-top: 5px; color: #6f6266; font-size: 9px; }
    .main { flex: 1; height: 100%; min-width: 0; display: flex; flex-direction: column; }
    .topbar { height: 78px; min-height: 78px; display: flex; align-items: center; padding: 0 28px; border-bottom: 1px solid #3b2932; background: rgba(19,15,19,.78); }
    .search-wrap { position: relative; width: 430px; }
    .search-icon { position: absolute; left: 15px; top: 11px; color: #7f6f73; font-size: 15px; }
    .search {
      width: 100%; height: 40px; border: 1px solid #43313a; border-radius: 10px; outline: 0;
      color: #f4e9db; background: #211920; padding: 0 42px; font-size: 12px;
    }
    .search:focus { border-color: #a54855; box-shadow: 0 0 0 3px rgba(165,72,85,.12); }
    .kbd { position: absolute; right: 10px; top: 10px; color: #71646a; font-size: 9px; border: 1px solid #493942; padding: 3px 6px; border-radius: 5px; }
    .top-actions { margin-left: auto; display: flex; align-items: center; }
    .ghost-btn, .danger-btn { border: 1px solid #4a363f; border-radius: 9px; color: #bcaeb0; background: #211920; padding: 9px 13px; margin-left: 8px; font-size: 11px; }
    .ghost-btn:hover { color: #fff; border-color: #74515d; }
    .danger-btn { color: #e58d95; }
    .danger-btn:hover { color: #fff; border-color: #a94954; background: #3d2028; }
    .content { flex: 1; min-height: 0; overflow-y: auto; padding: 25px 28px; }
    .hero { display: flex; align-items: flex-end; margin-bottom: 20px; }
    .hero-copy { flex: 1; }
    .eyebrow { font-size: 10px; color: #d65c68; letter-spacing: 2.5px; font-weight: 800; }
    .page-title { margin: 6px 0 5px; font-size: 27px; color: #fff6e9; line-height: 1.2; }
    .page-desc { color: #8f7f84; font-size: 11px; }
    .legend { color: #79696e; font-size: 10px; white-space: nowrap; padding-bottom: 3px; }
    .section-title { font-size: 11px; letter-spacing: 1.5px; color: #a08d92; margin: 22px 0 10px; }
    .section-title strong { color: #efe0d2; font-size: 13px; margin-right: 9px; }
    .grid { display: flex; flex-wrap: wrap; margin: 0 -6px; }
    .card-wrap { width: 33.333%; padding: 6px; }
    .card {
      height: 164px; position: relative; overflow: hidden; padding: 16px; border-radius: 13px;
      background: linear-gradient(145deg, #261d23, #1c171c); border: 1px solid #423039;
      box-shadow: 0 8px 25px rgba(0,0,0,.12); transition: .16s;
    }
    .card:hover { border-color: #74515c; transform: translateY(-2px); box-shadow: 0 11px 28px rgba(0,0,0,.24); }
    .card.hot { border-color: #67404a; background: linear-gradient(145deg, #312027, #1e171c); }
    .card-glow { position: absolute; width: 110px; height: 110px; right: -40px; top: -50px; border-radius: 50%; opacity: .13; background: #ed6674; filter: blur(6px); }
    .card-head { display: flex; align-items: center; position: relative; z-index: 1; }
    .sigil {
      width: 37px; height: 37px; min-width: 37px; line-height: 37px; border-radius: 10px; margin-right: 10px;
      text-align: center; color: #fff6ea; font-size: 16px; font-weight: 900; background: linear-gradient(145deg, #9e3f4c, #5d2933);
      box-shadow: inset 0 1px rgba(255,255,255,.14), 0 5px 12px rgba(0,0,0,.24);
    }
    .sigil.gold { background: linear-gradient(145deg, #b88442, #674a28); }
    .sigil.blue { background: linear-gradient(145deg, #507798, #314658); }
    .sigil.green { background: linear-gradient(145deg, #4d866c, #2b4f40); }
    .item-main { min-width: 0; flex: 1; }
    .item-name { color: #fff5e8; font-size: 14px; font-weight: 800; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .item-en { color: #75666b; font-size: 9px; margin-top: 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .tier { margin-left: 6px; border: 1px solid #6a3f48; border-radius: 6px; padding: 3px 6px; color: #ed8c95; font-size: 9px; font-weight: 800; }
    .tier.a { color: #e8bd74; border-color: #6c5532; }
    .fav { border: 0; background: transparent; color: #66565b; font-size: 18px; padding: 0 0 0 7px; line-height: 1; }
    .fav.on { color: #f0b653; text-shadow: 0 0 8px rgba(240,182,83,.45); }
    .item-desc { height: 31px; margin-top: 11px; color: #a8979b; font-size: 10px; line-height: 1.5; overflow: hidden; }
    .card-foot { position: absolute; left: 16px; right: 16px; bottom: 13px; display: flex; align-items: center; }
    .code { color: #6e6266; font-family: Consolas, monospace; font-size: 9px; flex: 1; }
    .remove-btn { border: 0; color: #786b6e; background: transparent; font-size: 10px; padding: 7px 8px; }
    .remove-btn:hover { color: #e1999f; }
    .give-btn { border: 0; border-radius: 7px; color: #fff; background: #8d3945; padding: 7px 11px; font-size: 10px; font-weight: 700; }
    .give-btn:hover { background: #b34c59; }
    .command-card { height: 132px; }
    .command-card .item-desc { height: 30px; }
    .command-card .give-btn { padding-left: 16px; padding-right: 16px; }
    .empty { width: 100%; text-align: center; padding: 60px 20px; color: #74656a; }
    .empty-big { font-size: 30px; margin-bottom: 10px; color: #4e3c43; }
    .dock {
      position: relative; z-index: 20; flex: 0 0 94px; height: 94px; margin: 0 22px 18px;
      border: 1px solid #513943; border-radius: 14px; background: rgba(30,23,29,.97);
      box-shadow: 0 15px 40px rgba(0,0,0,.45); padding: 13px 15px;
    }
    .dock-head { display: flex; align-items: center; margin-bottom: 8px; }
    .dock-title { font-size: 10px; font-weight: 800; letter-spacing: 1.2px; color: #c5b3b7; }
    .dock-hint { margin-left: 9px; color: #6f6267; font-size: 9px; }
    .mode-label { margin-left: auto; color: #796b70; font-size: 9px; }
    .send-mode { height: 24px; margin-left: 7px; border: 1px solid #49343e; border-radius: 6px; outline: 0; color: #cbbbc0; background: #171217; padding: 0 7px; font-size: 9px; }
    .repeat-label { margin-left: 13px; color: #796b70; font-size: 9px; }
    .repeat-control { display: flex; height: 24px; margin-left: 7px; border: 1px solid #49343e; border-radius: 6px; overflow: hidden; background: #171217; }
    .repeat-btn { width: 24px; border: 0; color: #cbbbc0; background: #241a20; font-size: 14px; line-height: 22px; }
    .repeat-btn:hover { color: #fff; background: #493039; }
    .repeat-input { width: 34px; height: 22px; border: 0; border-left: 1px solid #49343e; border-right: 1px solid #49343e; outline: 0; color: #f3d9c2; background: #171217; text-align: center; font: 10px Consolas,monospace; }
    .repeat-warning { display: none; margin-left: 7px; color: #e2ac64; font-size: 9px; white-space: nowrap; }
    .recent { margin-left: auto; color: #796c70; font-size: 9px; max-width: 42%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
    .command-row { display: flex; }
    .command-input { flex: 1; height: 37px; border: 1px solid #49343e; border-radius: 8px 0 0 8px; outline: none; color: #f2e7d8; background: #151116; padding: 0 13px; font: 12px Consolas, monospace; }
    .command-input:focus { border-color: #a64855; }
    .copy-btn { width: 66px; border: 1px solid #49343e; border-left: 0; color: #ad9da1; background: #21191f; font-size: 10px; }
    .send-btn { width: 104px; border: 0; border-radius: 0 8px 8px 0; color: #fff; background: linear-gradient(135deg, #a54350, #7a303b); font-size: 11px; font-weight: 800; }
    .send-btn:hover { background: linear-gradient(135deg, #c45260, #923945); }
    .send-btn.disabled { cursor: wait; color: #9f8f92; background: #49363d; }
    .toast { position: fixed; right: 25px; top: 91px; z-index: 99; min-width: 230px; max-width: 390px; padding: 13px 15px; border-radius: 10px; color: #eee3d5; background: #34252d; border: 1px solid #66454f; box-shadow: 0 12px 30px rgba(0,0,0,.34); font-size: 11px; display: none; }
    .toast.ok { border-color: #3f745b; background: #203a30; }
    .toast.warn { border-color: #8a6739; background: #44331f; }
    .mini-note { display: inline-block; margin-left: 8px; color: #e2ac64; font-size: 9px; }
    .modal-backdrop { position: fixed; z-index: 200; left: 0; top: 0; width: 100%; height: 100%; display: none; align-items: center; justify-content: center; background: rgba(10,8,11,.82); }
    .modal { width: 760px; max-height: 84%; overflow-y: auto; border: 1px solid #68454f; border-radius: 16px; padding: 25px 27px; color: #d8c9bd; background: linear-gradient(145deg,#2b2026,#181419); box-shadow: 0 25px 70px rgba(0,0,0,.65); }
    .modal-head { display: flex; align-items: flex-start; border-bottom: 1px solid #48343d; padding-bottom: 17px; }
    .modal-title { margin: 4px 0 5px; color: #fff5e8; font-size: 22px; }
    .modal-sub { color: #8e7d82; font-size: 11px; }
    .modal-close { margin-left: auto; border: 1px solid #533c44; border-radius: 8px; color: #b7a6aa; background: #20191e; padding: 7px 11px; }
    .tutorial-grid { display: flex; margin: 17px -7px 0; }
    .tutorial-col { width: 50%; padding: 0 7px; }
    .tutorial-box { min-height: 128px; margin-bottom: 12px; padding: 14px 15px; border: 1px solid #44323a; border-radius: 11px; background: #1c171b; }
    .tutorial-box h3 { margin: 0 0 9px; color: #f0e1d3; font-size: 12px; }
    .tutorial-box p, .tutorial-box li { color: #9f8e93; font-size: 10px; line-height: 1.7; }
    .tutorial-box ol, .tutorial-box ul { margin: 0; padding-left: 19px; }
    .path-code { display: block; margin-top: 7px; padding: 8px 9px; border-radius: 6px; color: #d6a972; background: #120f12; font: 9px Consolas,monospace; word-break: break-all; }
    .modal-foot { display: flex; align-items: center; margin-top: 8px; }
    .modal-note { flex: 1; color: #796a6f; font-size: 9px; }
    .primary-modal { border: 0; border-radius: 8px; color: #fff; background: #963c49; padding: 9px 17px; font-weight: 700; }
    @media (max-width: 1080px) { .card-wrap { width: 50%; } .search-wrap { width: 340px; } .dock-hint, .recent, .repeat-warning { display: none; } }
  </style>
</head>
<body>
  <div class="app">
    <aside class="sidebar">
      <div class="brand">
        <div class="brand-top">BINDING TOOLS</div>
        <div class="brand-title">以撒 · 控制台</div>
        <div class="brand-sub">Repentance 中文辅助面板</div>
      </div>
      <div class="nav" id="nav"></div>
      <div class="status-box">
        <div class="status-line"><span class="status-dot" id="statusDot"></span><span id="statusText">正在检测游戏…</span></div>
        <div class="status-tip">发送前请先进入一局游戏</div>
      </div>
    </aside>

    <main class="main">
      <header class="topbar">
        <div class="search-wrap">
          <span class="search-icon">⌕</span>
          <input id="search" class="search" type="text" placeholder="搜索中文名、英文名、效果或 ID…" />
          <span class="kbd">Ctrl + K</span>
        </div>
        <div class="top-actions">
          <button class="ghost-btn" onclick="showTutorial()">使用教程</button>
          <button class="ghost-btn" onclick="showHistory()">最近命令</button>
          <button class="danger-btn" onclick="confirmClearItems()">清空道具</button>
        </div>
      </header>

      <section class="content" id="content">
        <div class="hero">
          <div class="hero-copy">
            <div class="eyebrow" id="eyebrow">CURATED LOADOUT</div>
            <h1 class="page-title" id="pageTitle">常用精选</h1>
            <div class="page-desc" id="pageDesc">高强度与高频道具已按优先级排在最前。</div>
          </div>
          <div class="legend"><span style="color:#ed8c95">S</span> 顶级强度　<span style="color:#e8bd74">A</span> 常用推荐</div>
        </div>
        <div id="cards"></div>
      </section>
      <div class="dock">
        <div class="dock-head">
          <span class="dock-title">手动命令</span><span class="dock-hint">执行后使用 Esc 自动关闭控制台</span>
          <span class="mode-label">发送模式</span><select class="send-mode" id="sendMode"><option value="auto">自动打开并关闭</option><option value="open">控制台已打开（执行后关闭）</option></select>
          <span class="repeat-label">执行次数</span><span class="repeat-control"><button class="repeat-btn" onclick="adjustRepeat(-1)" title="减少一次">−</button><input class="repeat-input" id="repeatCount" type="text" value="1" maxlength="2" onkeyup="normalizeRepeat(false)" onblur="normalizeRepeat(true)" /><button class="repeat-btn" onclick="adjustRepeat(1)" title="增加一次">+</button></span>
          <span class="repeat-warning" id="repeatWarning">超过 20 次可能卡顿</span>
          <span class="recent" id="recent">当前：giveitem c182</span>
        </div>
        <div class="command-row">
          <input class="command-input" id="manualCommand" type="text" value="giveitem c182" />
          <button class="copy-btn" onclick="copyManual()">复制</button>
          <button class="send-btn" id="sendBtn" onclick="sendManual()">发送到游戏</button>
        </div>
      </div>
    </main>
  </div>
  <div class="toast" id="toast"></div>

  <div class="modal-backdrop" id="tutorialModal">
    <div class="modal">
      <div class="modal-head">
        <div><div class="eyebrow">QUICK START</div><h2 class="modal-title">第一次使用：三分钟上手</h2><div class="modal-sub">本工具不修改游戏文件、不安装 Mod，只替你操作游戏内置控制台。</div></div>
        <button class="modal-close" onclick="hideTutorial()">关闭</button>
      </div>
      <div class="tutorial-grid">
        <div class="tutorial-col">
          <div class="tutorial-box"><h3>① 前置要求</h3><ul><li>Windows 10 / 11 与 Steam 版 Isaac</li><li>推荐 Repentance；道具库按该版本整理</li><li>PowerShell 5.1 和 mshta（Windows 自带）</li><li>游戏内置调试控制台必须已开启</li></ul></div>
          <div class="tutorial-box"><h3>② 开启内置控制台</h3><p>关闭游戏，找到对应版本的 options.ini，把 EnableDebugConsole 改成 1 后保存。</p><span class="path-code">文档\My Games\Binding of Isaac Repentance\options.ini</span><p>若使用 Repentance+，目录名通常是 Binding of Isaac Repentance+。</p></div>
        </div>
        <div class="tutorial-col">
          <div class="tutorial-box"><h3>③ 正确发送与批量执行</h3><ol><li>启动游戏并进入一局，保持原生控制台关闭</li><li>在底部用 − / + 或输入框设置 1–99 次</li><li>点击操作；giveitem、spawn 会在同一控制台会话中连续执行</li><li>全部完成后工具只按一次 Esc 关闭控制台</li></ol></div>
          <div class="tutorial-box"><h3>④ 安全规则与失败处理</h3><ul><li>debug、stage、kill、remove 等始终只执行 1 次</li><li>超过 20 次会提醒卡顿风险，但不会阻止</li><li>部分完成会显示实际进度，请勿直接整批重试</li><li>完全失败时保留次数并复制命令，便于排查后重试</li></ul></div>
        </div>
      </div>
      <div class="modal-foot"><div class="modal-note">提示：使用控制台可能影响成就或解锁条件，建议用于娱乐/测试存档。</div><button class="primary-modal" onclick="hideTutorial()">我知道了，开始使用</button></div>
    </div>
  </div>

  <script language="javascript">
    var categories = [
      { id:"featured", group:"精选", icon:"✦", name:"常用精选", desc:"你收藏的道具，以及每类最常用的高强度选择。", eyebrow:"CURATED LOADOUT" },
      { id:"damage", group:"道具", icon:"刃", name:"输出核心", desc:"伤害、射击方式与高强度叠加核心。", eyebrow:"DAMAGE & TEARS" },
      { id:"defense", group:"道具", icon:"盾", name:"生存防御", desc:"护盾、减伤、免疫与容错道具。", eyebrow:"SURVIVAL" },
      { id:"economy", group:"道具", icon:"$", name:"资源经济", desc:"商店、掉落与资源成长道具。", eyebrow:"ECONOMY" },
      { id:"explore", group:"道具", icon:"图", name:"地图探索", desc:"地图显示、隐藏房与房间移动工具。", eyebrow:"NAVIGATION" },
      { id:"active", group:"道具", icon:"骰", name:"主动神器", desc:"重随、回溯、重开与改变流程的强力主动道具。", eyebrow:"ACTIVE ITEMS" },
      { id:"familiar", group:"道具", icon:"伴", name:"跟班军团", desc:"输出、格挡与续航型跟班。", eyebrow:"FAMILIARS" },
      { id:"fun", group:"道具", icon:"乱", name:"趣味组合", desc:"适合测试构筑与制造夸张联动。", eyebrow:"CHAOS LAB" },
      { id:"debug", group:"控制台", icon:"⚙", name:"调试能力", desc:"无敌、高伤、无限充能与信息显示开关。再次点击同一 debug 命令可关闭。", eyebrow:"DEBUG FLAGS" },
      { id:"supply", group:"控制台", icon:"+", name:"即时补给", desc:"生成资源、回复与当前房间辅助。", eyebrow:"SUPPLY DROP" },
      { id:"stage", group:"控制台", icon:"门", name:"楼层跳转", desc:"直接进入指定主线楼层；会改变当前流程，请谨慎使用。", eyebrow:"STAGE WARP" }
    ];

    var items = [
      {id:182,cat:"damage",name:"圣心",en:"Sacred Heart",tier:"S",icon:"心",desc:"高额伤害倍率、自追踪与生命上限，最稳定的顶级输出核心。",hot:1},
      {id:331,cat:"damage",name:"神性",en:"Godhead",tier:"S",icon:"神",desc:"追踪泪弹附带持续伤害光环，清图与对 Boss 都很强。",hot:1},
      {id:118,cat:"damage",name:"硫磺火",en:"Brimstone",tier:"S",icon:"硫",desc:"蓄力发射贯穿房间的血激光，经典强力射击方式。",hot:1},
      {id:114,cat:"damage",name:"妈妈的刀",en:"Mom's Knife",tier:"S",icon:"刀",desc:"将泪弹替换为蓄力飞刀，近远距离都拥有极高伤害。",hot:1},
