<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>以撒 · 中文控制台 desktop-v1.4.2</title>
  <HTA:APPLICATION ID="IsaacConsole" APPLICATIONNAME="Isaac 中文控制台" BORDER="thin" CAPTION="yes" MAXIMIZEBUTTON="yes" MINIMIZEBUTTON="yes" SCROLL="no" SINGLEINSTANCE="yes" WINDOWSTATE="normal" />
  <link rel="stylesheet" type="text/css" href="desktop/app.css" />
  <script type="text/javascript">
    window.onerror = function (message, source, line) {
      var detail = "启动脚本错误：" + message + "\r\n文件：" + source + "\r\n行号：" + line;
      var logPath = "%LOCALAPPDATA%\\IsaacChineseConsole\\startup-error.log";
      try {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var shell = new ActiveXObject("WScript.Shell");
        var folder = shell.ExpandEnvironmentStrings("%LOCALAPPDATA%") + "\\IsaacChineseConsole";
        if (!fso.FolderExists(folder)) fso.CreateFolder(folder);
        logPath = fso.BuildPath(folder, "startup-error.log");
        var file = fso.CreateTextFile(logPath, true, true);
        file.WriteLine(new Date().toLocaleString());
        file.Write(detail);
        file.Close();
      } catch (ignore) {}
      try {
        document.body.innerHTML = '<div style="font-family:Segoe UI,Microsoft YaHei,sans-serif;padding:32px;background:#17131f;color:#f2e9dc;min-height:100%">' +
          '<h2 style="color:#e39b6d">控制台界面初始化失败</h2><p>请把下面的信息发回来：</p><pre style="white-space:pre-wrap;background:#251e30;padding:16px;border:1px solid #59476d">' +
          String(detail).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;") + '</pre><p>诊断日志：' + logPath + '</p></div>';
      } catch (ignore2) {}
      return true;
    };
  </script>
</head>
<body>
  <div class="app">
    <aside class="sidebar">
      <div class="brand">
        <div class="brand-top">BINDING TOOLS</div>
        <div class="brand-title">以撒 · 控制台</div>
        <div class="brand-sub">desktop-v1.4.2 · 自检启动版</div>
      </div>
      <div class="nav" id="nav"></div>
      <div class="status-box">
        <div class="status-line"><span class="status-dot" id="statusDot"></span><span id="statusText">正在检测游戏…</span></div>
        <div class="status-tip" id="catalogStatus">精选目录 74 项 · EID 尚未导入</div>
      </div>
    </aside>

    <main class="main">
      <header class="topbar">
        <div class="search-wrap">
          <span class="search-icon">⌕</span>
          <input id="search" class="search" type="text" placeholder="搜索中文、英文、拼音、命令或 ID…" />
          <span class="kbd">Ctrl + K</span>
        </div>
        <div class="top-actions">
          <button class="ghost-btn optional" onclick="IsaacApp.importCatalog()">导入 EID</button>
          <button class="ghost-btn" onclick="IsaacApp.showHistory()">历史</button>
          <button class="ghost-btn" onclick="IsaacApp.showSavedQueues()">方案</button>
          <button class="ghost-btn" onclick="IsaacApp.openQueue()">队列 <span id="queueCount">0</span></button>
        </div>
      </header>

      <section class="content" id="content">
        <div class="hero">
          <div class="hero-copy">
            <div class="eyebrow" id="eyebrow">CURATED LOADOUT</div>
            <h1 class="page-title" id="pageTitle">常用精选</h1>
            <div class="page-desc" id="pageDesc">高强度与常用道具按原分类保留。</div>
          </div>
          <div class="hero-tools">
            <div class="stage-mode" id="stageMode">
              <button id="stageNormal" onclick="IsaacApp.setStageMode('normal')">普通</button><button id="stageGreed" onclick="IsaacApp.setStageMode('greed')">贪婪</button>
            </div>
            <div class="pager"><button onclick="IsaacApp.changePage(-1)">←</button><span id="pageIndicator">1 / 1</span><button onclick="IsaacApp.changePage(1)">→</button></div>
          </div>
        </div>
        <div class="section-title"><strong id="sectionLabel">优先推荐</strong><span id="resultCount">0 项</span><span class="catalog-badge" id="resultSource"></span></div>
        <div id="cards"></div>
      </section>

      <div class="dock">
        <div class="dock-head">
          <span class="dock-title">手动命令</span><span id="manualRisk">任意单行命令均可入队</span>
          <span class="mode-label">发送模式</span>
          <select class="send-mode" id="sendMode"><option value="auto">自动打开并关闭</option><option value="open">控制台已打开</option></select>
          <span class="repeat-control"><button onclick="IsaacApp.adjustManualRepeat(-1)">−</button><input id="repeatCount" type="text" value="1" maxlength="2" /><button onclick="IsaacApp.adjustManualRepeat(1)">+</button></span>
        </div>
        <div class="command-row">
          <input class="command-input" id="manualCommand" type="text" value="giveitem c182" />
          <button class="command-btn" onclick="IsaacApp.copyManual()">复制</button>
          <button class="command-btn" onclick="IsaacApp.addManualToQueue()">加入队列</button>
          <button class="command-btn primary" id="sendBtn" onclick="IsaacApp.sendManual()">立即执行</button>
        </div>
      </div>
    </main>
  </div>

  <aside class="drawer" id="detailDrawer">
    <div class="drawer-head"><div class="drawer-title">道具详情</div><button class="drawer-close" onclick="IsaacApp.closeDrawers()">×</button></div>
    <div id="detailBody"></div>
  </aside>

  <aside class="drawer" id="queueDrawer">
    <div class="drawer-head"><div class="drawer-title">命令队列</div><button class="drawer-close" onclick="IsaacApp.closeDrawers()">×</button></div>
    <div class="queue-summary" id="queueSummary">队列为空</div>
    <div class="progress" id="queueProgress"></div>
    <div class="queue-list" id="queueList"></div>
    <div class="detail-actions">
      <button class="small-btn" onclick="IsaacApp.saveCurrentQueue()">保存方案</button>
      <button class="small-btn" onclick="IsaacApp.clearQueue()">清空</button>
      <button class="small-btn" id="cancelQueueBtn" onclick="IsaacApp.cancelQueue()">取消执行</button>
      <button class="danger-btn" id="executeQueueBtn" onclick="IsaacApp.executeQueue()">执行队列</button>
    </div>
  </aside>

  <div class="modal-backdrop" id="modalBackdrop">
    <div class="modal">
      <div class="drawer-head"><div class="drawer-title" id="modalTitle">记录</div><button class="drawer-close" onclick="IsaacApp.closeModal()">×</button></div>
      <div id="modalBody"></div>
    </div>
  </div>
  <div class="toast" id="toast"></div>

  <script type="text/javascript" src="desktop/catalog.js"></script>
  <script type="text/javascript" src="desktop/curated-aliases.js"></script>
  <script type="text/javascript" src="desktop/state.js"></script>
  <script type="text/javascript" src="desktop/search.js"></script>
  <script type="text/javascript" src="desktop/queue.js"></script>
  <script type="text/javascript" src="desktop/app.js"></script>
</body>
</html>
